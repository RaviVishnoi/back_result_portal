# Disable directory listing
Options -Indexes

# Redirect old hyphenated application URLs after filename normalization
RewriteEngine On
RewriteRule ^admin-login\.php$ admin_login.php [R=301,L]
RewriteRule ^view-result\.php$ view_result.php [R=301,L]
RewriteRule ^admin/add-student\.php$ admin/add_student.php [R=301,L]
RewriteRule ^admin/bulk-upload-students\.php$ admin/bulk_upload_students.php [R=301,L]
RewriteRule ^admin/edit-exam\.php$ admin/edit_exam.php [R=301,L]
RewriteRule ^admin/edit-student-result\.php$ admin/edit_student_result.php [R=301,L]
RewriteRule ^admin/edit-student\.php$ admin/edit_student.php [R=301,L]
RewriteRule ^admin/exam-results\.php$ admin/exam_results.php [R=301,L]
RewriteRule ^admin/forgot-password\.php$ admin/forgot_password.php [R=301,L]
RewriteRule ^admin/manage-exams\.php$ admin/manage_exams.php [R=301,L]
RewriteRule ^admin/manage-students\.php$ admin/manage_students.php [R=301,L]
RewriteRule ^admin/reset-password\.php$ admin/reset_password.php [R=301,L]
RewriteRule ^admin/upload-result\.php$ admin/upload_result.php [R=301,L]
RewriteRule ^assets/images/hero-bg\.jpg$ assets/images/hero_bg.jpg [R=301,L]

# Block access to sensitive files
<FilesMatch "\.(sql|csv|xlsx|json|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to config.php
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Block access to dotenv files and environment-specific configuration.
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
